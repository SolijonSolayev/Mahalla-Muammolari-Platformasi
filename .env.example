# Bot token (majburiy)
# BOT_TOKEN - faqat shu muhit o'zgaruvchisidan olinadi. Hech qachon ochiq kodga token yozmang.
BOT_TOKEN=

# DATA_DIR (majburiy)
# Doimiy ma'lumotlar faqat shu papkada saqlansin (masalan: /app/data yoki ./data)
# Bot ichida fayl yozish va yaratish faqat shu papkada bo'ladi.
DATA_DIR=./data

# ADMIN_IDS (ixtiyoriy)
# Agar bir nechta admin bo'lsa, ularni vergul bilan ajrating, masalan: 12345,67890
ADMIN_IDS=

# TELEGRAM_API_URL (ixtiyoriy)
# Agar maxsus Telegram API manzili (proksi) kerak bo'lsa, kiriting. Odatda Botxona o'z proksisini ishlatadi.
TELEGRAM_API_URL=

# WEBHOOK sozlamalari (ixtiyoriy)
# Agar webhook ishlatmoqchi bo'lsangiz to'ldiring:
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=

# WEB SERVER PORT (ixtiyoriy; webhook ishlatilsa)
PORT=8080
